<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'fish-ore-bag-filter-title'}"
                      MinSize="360 300"
                      SetSize="420 480">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  SeparationOverride="8"
                  Margin="8">
        <RichTextLabel Text="{Loc 'fish-ore-bag-filter-description'}" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="SelectAllButton"
                    Text="{Loc 'fish-ore-bag-filter-select-all'}"
                    HorizontalExpand="True" />
            <Button Name="ClearAllButton"
                    Text="{Loc 'fish-ore-bag-filter-clear-all'}"
                    HorizontalExpand="True" />
        </BoxContainer>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="StackEntries"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          SeparationOverride="4" />
        </ScrollContainer>
        <CheckBox Name="OtherCheckBox" Text="{Loc 'fish-ore-bag-filter-other'}" />
    </BoxContainer>
</controls:FancyWindow>
