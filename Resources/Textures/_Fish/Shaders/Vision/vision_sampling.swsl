// Экран уже прошёл FOV: чёрные области не дают засветку и не участвуют в замере.
bool night_visible(highp vec2 uv) {
    highp vec3 sample_color = zTextureSpec(SCREEN_TEXTURE, uv).rgb;
    return max(max(sample_color.r, sample_color.g), sample_color.b) > 0.0001;
}

highp float luminance(highp vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}
