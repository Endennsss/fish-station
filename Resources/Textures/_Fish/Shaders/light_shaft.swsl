light_mode unshaded;
blend_mode add;

uniform highp float intensity;
uniform highp float cone_tangent;
uniform highp float falloff;
uniform highp float softness;
uniform highp float noise_amount;
uniform highp float noise_speed;
uniform highp float levels;

void fragment() {
    // UV — нормализованные координаты в конусе, а не координаты текстуры.
    highp float radius = length(vec2(UV.x, UV.y * cone_tangent));
    highp float side = abs(UV.y) / max(UV.x, 0.001);
    highp float edge = 1.0 - smoothstep(1.0 - softness, 1.0, side);
    highp float fade = pow(max(1.0 - radius, 0.0), falloff);
    highp float value = edge * fade * smoothstep(0.0, 0.015, UV.x);
    highp float noise = zRandom(floor(FRAGCOORD.xy) + vec2(floor(TIME * noise_speed))).x * 0.5;
    if (levels > 1.0) {
        value = floor(value * levels + noise + 0.5) / levels;
    }
    value = max(value * (1.0 + noise * noise_amount), 0.0);
    if (value * intensity <= 0.00001) {
        discard;
    }
    COLOR = vec4(vec3(1.0), clamp(value * intensity, 0.0, 0.6));
}
