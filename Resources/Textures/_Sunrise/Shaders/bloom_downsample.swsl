light_mode unshaded;
blend_mode none;

// FIsh edit - линейный box-filter перед каждым уменьшением маски в два раза.
void fragment() {
    highp vec2 offset = TEXTURE_PIXEL_SIZE * 0.5;
    mediump vec4 result = zTexture(UV + vec2(-offset.x, -offset.y));
    result += zTexture(UV + vec2(offset.x, -offset.y));
    result += zTexture(UV + vec2(-offset.x, offset.y));
    result += zTexture(UV + vec2(offset.x, offset.y));
    COLOR = result * 0.25;
}
