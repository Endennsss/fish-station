light_mode unshaded;
blend_mode add;

uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D near_texture;
uniform sampler2D medium_texture;
uniform sampler2D wide_texture;
uniform lowp float bloom_strength;

const mediump float core_weight = 0.16;
const mediump float near_weight = 0.50;
const mediump float medium_weight = 0.32;
const mediump float wide_weight = 0.18;
const mediump float bloom_threshold = 0.003;
const mediump float bloom_soft_knee = 0.012;
const mediump float background_suppression = 0.35;

void fragment() {
    mediump vec3 core = zTexture(UV).rgb;
    mediump vec3 near_glow = zTextureSpec(near_texture, UV2).rgb;
    mediump vec3 medium_glow = zTextureSpec(medium_texture, UV2).rgb;
    mediump vec3 wide_glow = zTextureSpec(wide_texture, UV2).rgb;

    mediump vec3 bloom = core * core_weight;
    bloom += near_glow * near_weight;
    bloom += medium_glow * medium_weight;
    bloom += wide_glow * wide_weight;

    mediump float luminance = zGrayscale_BT709(bloom);
    mediump float threshold_factor = smoothstep(
        bloom_threshold,
        bloom_threshold + bloom_soft_knee,
        luminance);

    highp vec2 screen_uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    mediump vec3 background = zTextureSpec(SCREEN_TEXTURE, screen_uv).rgb;
    mediump float background_luminance = zGrayscale_BT709(background);
    mediump float background_factor = 1.0 - background_suppression *
        smoothstep(0.2, 0.85, background_luminance);
    lowp float intensity = clamp(
        bloom_strength * threshold_factor * background_factor,
        0.0,
        1.0);

    if (intensity <= 0.0)
        discard;

    // FIsh edit - добавляем только положительный bloom, не перерисовывая фон.
    COLOR = vec4(max(bloom, vec3(0.0)), intensity);
}
